<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Duetto.ViewModels"
             x:Class="Duetto.Views.SearchResultsView"
             x:DataType="vm:SearchViewModel"
             Background="{StaticResource PaneBg}">
  <Grid RowDefinitions="30,24,*,26">
    <!-- Results header -->
    <Border Grid.Row="0" Background="{StaticResource ActivePathBg}"
            BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1">
      <DockPanel Margin="12,0" VerticalAlignment="Center">
        <TextBlock DockPanel.Dock="Left" FontSize="11.5" FontWeight="SemiBold"
                   Foreground="{StaticResource Accent}" VerticalAlignment="Center">
          <Run Text="Results for “" /><Run Text="{Binding HeaderQuery}" /><Run Text="”" />
        </TextBlock>
        <TextBlock DockPanel.Dock="Left" Margin="8,0,0,0"
                   FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                   Foreground="{StaticResource AccentDim}" VerticalAlignment="Center">
          <Run Text="below " /><Run Text="{Binding ScopeDirName}" /><Run Text="/" />
          <Run Text=" · " /><Run Text="{Binding ElapsedText}" />
        </TextBlock>
        <Button DockPanel.Dock="Right" Content="Open as pane ↗"
                Command="{Binding PinResultsCommand}"
                IsVisible="{Binding !IsPinned}"
                Background="Transparent" BorderThickness="0" Padding="0" MinHeight="0"
                FontSize="11" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
        <Panel />
      </DockPanel>
    </Border>

    <!-- Column headers -->
    <Border Grid.Row="1" Background="{StaticResource WindowBg}"
            BorderBrush="{StaticResource HairlineLight}" BorderThickness="0,0,0,1">
      <Grid Margin="12,0" ColumnDefinitions="*,14,200,14,70,14,96">
        <TextBlock Grid.Column="0" Text="NAME" FontSize="10.5" LetterSpacing="0.5" Foreground="{StaticResource HeaderText}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="FOLDER" FontSize="10.5" LetterSpacing="0.5" Foreground="{StaticResource HeaderText}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="4" Text="SIZE" FontSize="10.5" LetterSpacing="0.5" Foreground="{StaticResource HeaderText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        <TextBlock Grid.Column="6" Text="MODIFIED" FontSize="10.5" LetterSpacing="0.5" Foreground="{StaticResource HeaderText}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- Result rows (29px per design) -->
    <ListBox Grid.Row="2" x:Name="ResultList"
             Background="{StaticResource PaneBg}"
             ItemsSource="{Binding Results}"
             Selection="{Binding Selection}"
             SelectionMode="Multiple"
             DoubleTapped="OnResultDoubleTapped">
      <ListBox.ItemContainerTheme>
        <ControlTheme TargetType="ListBoxItem">
          <Setter Property="Height" Value="29" />
          <Setter Property="Padding" Value="12,0" />
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="Template">
            <ControlTemplate>
              <ContentPresenter Name="PART_ContentPresenter"
                                Background="{TemplateBinding Background}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Padding="{TemplateBinding Padding}"
                                VerticalContentAlignment="Center"
                                HorizontalContentAlignment="Stretch" />
            </ControlTemplate>
          </Setter>
          <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{StaticResource RowHover}" />
          </Style>
          <Style Selector="^:selected">
            <Setter Property="Background" Value="{StaticResource SelectionBg}" />
          </Style>
        </ControlTheme>
      </ListBox.ItemContainerTheme>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:SearchResultRowViewModel">
          <Grid ColumnDefinitions="*,14,200,14,70,14,96" VerticalAlignment="Center">
            <DockPanel Grid.Column="0" VerticalAlignment="Center">
              <Border DockPanel.Dock="Left" Width="11" Height="11" CornerRadius="2.5"
                      Background="{Binding MarkColor}" Margin="0,0,9,0" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{StaticResource TextBody}"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Grid.Column="2" Text="{Binding Folder}"
                       FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                       Foreground="{StaticResource TextFaint}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock Grid.Column="4" Text="{Binding SizeText}"
                       FontFamily="{StaticResource MonoFont}" FontSize="11"
                       Foreground="{StaticResource TextDim}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBlock Grid.Column="6" Text="{Binding ModifiedText}"
                       FontSize="11.5" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- Footer -->
    <Border Grid.Row="3" Background="{StaticResource ToolbarBg}"
            BorderBrush="{StaticResource HairlineLight}" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,0">
        <TextBlock Text="{Binding MatchText}" FontSize="11" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
        <TextBlock Text="·" FontSize="11" Foreground="{StaticResource TextHint}" VerticalAlignment="Center" />
        <TextBlock Text="Enter reveals in left pane" FontSize="11" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
        <TextBlock Text="·" FontSize="11" Foreground="{StaticResource TextHint}" VerticalAlignment="Center" />
        <TextBlock Text="Esc clear" FontSize="11" Foreground="{StaticResource TextGhost}" VerticalAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
