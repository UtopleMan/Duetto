<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Duetto.ViewModels"
             x:Class="Duetto.Views.ProgressStrip"
             x:DataType="vm:TransferViewModel">
  <Border Background="#f3f1ed"
          BorderBrush="{StaticResource HairlineDark}" BorderThickness="0,1,0,0"
          Padding="14,12">
    <StackPanel Spacing="9">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button Content="{Binding PauseLabel}" Command="{Binding TogglePauseCommand}"
                  IsVisible="{Binding !IsFinished}"
                  FontSize="11.5" Foreground="{StaticResource TextMid}" Background="{StaticResource ButtonHover}"
                  Padding="10,4" CornerRadius="6" BorderThickness="0" />
          <Button Content="{Binding CancelLabel}" Command="{Binding CancelOrDismissCommand}"
                  FontSize="11.5" Foreground="{StaticResource DangerText}" Background="{StaticResource DangerBg}"
                  Padding="10,4" CornerRadius="6" BorderThickness="0" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                     Foreground="#2f2e28" VerticalAlignment="Center" />
          <TextBlock Text="{Binding CurrentFileLine}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                     Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>

      <!-- Two-tone bar: solid green done, light green in-flight -->
      <Border Height="7" CornerRadius="4" Background="#dedbd3" ClipToBounds="True">
        <Grid x:Name="BarGrid">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0*" />
            <ColumnDefinition Width="0*" />
            <ColumnDefinition Width="100*" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="{StaticResource Green}" />
          <Border Grid.Column="1" Background="{StaticResource GreenLight}" />
        </Grid>
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="14">
        <TextBlock Text="{Binding FilesLine}" FontSize="11" Foreground="{StaticResource TextFaint}" />
        <TextBlock Text="{Binding SkippedLine}" FontSize="11" Foreground="{StaticResource TextFaint}"
                   IsVisible="{Binding HasSkipped}" />
        <Button IsVisible="{Binding HasSkipped}"
                Background="Transparent" BorderThickness="0" Padding="0" MinHeight="0"
                FontSize="11" Foreground="{StaticResource Accent}" Content="Review skipped">
          <Button.Flyout>
            <Flyout Placement="Top">
              <ItemsControl ItemsSource="{Binding SkippedItems}" MaxHeight="200">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}"
                               FontSize="11" Margin="0,2" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Flyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
