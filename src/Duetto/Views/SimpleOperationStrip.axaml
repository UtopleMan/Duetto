<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Duetto.ViewModels"
             x:Class="Duetto.Views.SimpleOperationStrip"
             x:DataType="vm:SimpleOperationViewModel">
  <Border Background="{StaticResource ChromeBg}"
          BorderBrush="{StaticResource HairlineDark}" BorderThickness="0,1,0,0"
          Padding="14,12">
    <DockPanel>
      <Button DockPanel.Dock="Right" Content="{Binding CancelLabel}"
              Command="{Binding CancelOrDismissCommand}"
              FontSize="11.5" Foreground="{StaticResource DangerText}" Background="{StaticResource DangerBg}"
              Padding="10,4" CornerRadius="6" BorderThickness="0" VerticalAlignment="Center" />
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <ProgressBar IsIndeterminate="{Binding !IsFinished}" Width="120" Height="6"
                     Minimum="0" Maximum="1" Value="1" />
        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                   Foreground="{StaticResource TextBody}" VerticalAlignment="Center" />
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
