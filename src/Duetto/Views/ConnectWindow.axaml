<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Duetto.ViewModels"
        x:Class="Duetto.Views.ConnectWindow"
        x:DataType="vm:ConnectDialogViewModel"
        Title="Connect to Server"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBg}"
        KeyDown="OnKeyDown">

  <StackPanel Margin="24,20,24,20" Spacing="0">

    <TextBlock Text="PROTOCOL" FontSize="10" FontWeight="SemiBold" LetterSpacing="1"
               Foreground="{StaticResource HeaderText}" Margin="0,0,0,4"/>
    <ComboBox x:Name="ProtocolBox" SelectedIndex="0" HorizontalAlignment="Stretch" Margin="0,0,0,14"
              SelectionChanged="OnProtocolChanged">
      <ComboBoxItem Content="SFTP" />
      <ComboBoxItem Content="SMB / Samba" />
      <ComboBoxItem Content="S3 / S3-compatible" />
      <ComboBoxItem Content="Azure Blob Storage" />
    </ComboBox>

    <TextBlock Text="CONNECTION NAME (optional)" FontSize="10" FontWeight="SemiBold" LetterSpacing="1"
               Foreground="{StaticResource HeaderText}" Margin="0,0,0,4"/>
    <TextBox Text="{Binding Name}" PlaceholderText="My Server" Margin="0,0,0,14"/>

    <Grid ColumnDefinitions="*,8,80" Margin="0,0,0,14" IsVisible="{Binding HostPortVisible}">
      <StackPanel Grid.Column="0" Spacing="4">
        <TextBlock Text="HOST" FontSize="10" FontWeight="SemiBold" LetterSpacing="1"
                   Foreground="{StaticResource HeaderText}"/>
        <TextBox Text="{Binding Host}" PlaceholderText="example.com or 192.168.1.1"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="4">
        <TextBlock Text="PORT" FontSize="10" FontWeight="SemiBold" LetterSpacing="1"
                   Foreground="{StaticResource HeaderText}"/>
        <TextBox Text="{Binding PortText}" PlaceholderText="22"/>
      </StackPanel>
    </Grid>

    <Grid ColumnDefinitions="*,8,120" Margin="0,0,0,14" IsVisible="{Binding S3FieldsVisible}">
      <StackPanel Grid.Column="0" Spacing="4">
        <TextBlock Text="ENDPOINT (blank = AWS)" FontSize="10" FontWeight="SemiBold" LetterSpacing="1"
                   Foreground="{StaticResource HeaderText}"/>
        <TextBox Text="{Binding Endpoint}" PlaceholderText="https://s3.example.com"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="4">
        <TextBlock Text="REGION" FontSize="10" FontWeight="SemiBold" LetterSpacing="1"
                   Foreground="{StaticResource HeaderText}"/>
        <TextBox Text="{Binding Region}" PlaceholderText="us-east-1"/>
      </StackPanel>
    </Grid>

    <CheckBox IsVisible="{Binding S3FieldsVisible}" IsChecked="{Binding PathStyle}"
              Content="Use path-style addressing (MinIO / on-prem)"
              Foreground="{StaticResource TextBody}" Margin="0,0,0,10"/>

    <StackPanel IsVisible="{Binding S3FieldsVisible}" Spacing="0">
      <TextBlock Text="CREDENTIALS" FontSize="10" FontWeight="SemiBold" LetterSpacing="1"
                 Foreground="{StaticResource HeaderText}" Margin="0,0,0,6"/>
      <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,10">
        <RadioButton Content="Access keys" IsChecked="{Binding IsS3KeysMode, Mode=OneWay}"
                     GroupName="S3Auth" Click="OnS3KeysModeClicked"/>
        <RadioButton Content="AWS profile" IsChecked="{Binding IsS3ProfileMode, Mode=OneWay}"
                     GroupName="S3Auth" Click="OnS3ProfileModeClicked"/>
        <RadioButton Content="Anonymous" IsChecked="{Binding IsS3AnonymousMode, Mode=OneWay}"
                     GroupName="S3Auth" Click="OnS3AnonymousModeClicked"/>
      </StackPanel>
    </StackPanel>

    <StackPanel IsVisible="{Binding S3KeysVisible}" Spacing="4" Margin="0,0,0,14">
      <TextBlock Text="ACCESS KEY ID" FontSize="10" FontWeight="SemiBold" LetterSpacing="1"
                 Foreground="{StaticResource HeaderText}"/>
      <TextBox Text="{Binding AccessKeyId}" PlaceholderText="AKIA…"/>
      <TextBlock Text="SECRET ACCESS KEY" FontSize="10" FontWeight="SemiBold" LetterSpacing="1"
                 Foreground="{StaticResource HeaderText}" Margin="0,8,0,0"/>
      <TextBox Text="{Binding SecretKey}" PasswordChar="•" PlaceholderText="(not stored unless checked below)"/>
      <TextBlock Text="SESSION TOKEN (optional)" FontSize="10" FontWeight="SemiBold" LetterSpacing="1"
                 Foreground="{StaticResource HeaderText}" Margin="0,8,0,0"/>
      <TextBox Text="{Binding SessionToken}" PasswordChar="•" PlaceholderText="(temporary / STS credentials)"/>
    </StackPanel>

    <StackPanel IsVisible="{Binding S3ProfileVisible}" Spacing="4" Margin="0,0,0,14">
      <TextBlock Text="AWS PROFILE" FontSize="10" FontWeight="SemiBold" LetterSpacing="1"
                 Foreground="{StaticResource HeaderText}"/>
      <TextBox Text="{Binding Profile}" PlaceholderText="default"/>
    </StackPanel>

    <StackPanel IsVisible="{Binding S3FieldsVisible}" Spacing="4" Margin="0,0,0,14">
      <TextBlock Text="BUCKET (blank = list all buckets)" FontSize="10" FontWeight="SemiBold" LetterSpacing="1"
                 Foreground="{StaticResource HeaderText}"/>
      <TextBox Text="{Binding Bucket}" PlaceholderText="my-bucket"/>
    </StackPanel>

    <StackPanel IsVisible="{Binding AzureFieldsVisible}" Spacing="4" Margin="0,0,0,14">
      <TextBlock Text="ENDPOINT (blank = {account}.blob.core.windows.net)" FontSize="10" FontWeight="SemiBold" LetterSpacing="1"
                 Foreground="{StaticResource HeaderText}"/>
      <TextBox Text="{Binding Endpoint}" PlaceholderText="http://127.0.0.1:10000/devstoreaccount1"/>
    </StackPanel>

    <StackPanel IsVisible="{Binding AzureAccountVisible}" Spacing="4" Margin="0,0,0,14">
      <TextBlock Text="STORAGE ACCOUNT" FontSize="10" FontWeight="SemiBold" LetterSpacing="1"
                 Foreground="{StaticResource HeaderText}"/>
      <TextBox Text="{Binding AzureAccount}" PlaceholderText="mystorageaccount"/>
    </StackPanel>

    <StackPanel IsVisible="{Binding AzureFieldsVisible}" Spacing="0">
      <TextBlock Text="CREDENTIALS" FontSize="10" FontWeight="SemiBold" LetterSpacing="1"
                 Foreground="{StaticResource HeaderText}" Margin="0,0,0,6"/>
      <WrapPanel Margin="0,0,0,4">
        <RadioButton Content="Account key" IsChecked="{Binding IsAzureSharedKeyMode, Mode=OneWay}"
                     GroupName="AzureAuth" Click="OnAzureSharedKeyModeClicked" Margin="0,0,16,6"/>
        <RadioButton Content="Connection string" IsChecked="{Binding IsAzureConnStringMode, Mode=OneWay}"
                     GroupName="AzureAuth" Click="OnAzureConnStringModeClicked" Margin="0,0,16,6"/>
        <RadioButton Content="SAS" IsChecked="{Binding IsAzureSasMode, Mode=OneWay}"
                     GroupName="AzureAuth" Click="OnAzureSasModeClicked" Margin="0,0,16,6"/>
        <RadioButton Content="Anonymous" IsChecked="{Binding IsAzureAnonymousMode, Mode=OneWay}"
                     GroupName="AzureAuth" Click="OnAzureAnonymousModeClicked" Margin="0,0,16,6"/>
      </WrapPanel>
    </StackPanel>

    <StackPanel IsVisible="{Binding AzureKeyVisible}" Spacing="4" Margin="0,0,0,14">
      <TextBlock Text="ACCOUNT KEY" FontSize="10" FontWeight="SemiBold" LetterSpacing="1"
                 Foreground="{StaticResource HeaderText}"/>
      <TextBox Text="{Binding AzureAccountKey}" PasswordChar="•" PlaceholderText="(not stored unless checked below)"/>
    </StackPanel>

    <StackPanel IsVisible="{Binding AzureConnStringVisible}" Spacing="4" Margin="0,0,0,14">
      <TextBlock Text="CONNECTION STRING" FontSize="10" FontWeight="SemiBold" LetterSpacing="1"
                 Foreground="{StaticResource HeaderText}"/>
      <TextBox Text="{Binding AzureConnectionString}" PasswordChar="•" PlaceholderText="DefaultEndpointsProtocol=…;AccountName=…;AccountKey=…"/>
    </StackPanel>

    <StackPanel IsVisible="{Binding AzureSasVisible}" Spacing="4" Margin="0,0,0,14">
      <TextBlock Text="SAS TOKEN OR URL" FontSize="10" FontWeight="SemiBold" LetterSpacing="1"
                 Foreground="{StaticResource HeaderText}"/>
      <TextBox Text="{Binding AzureSasToken}" PasswordChar="•" PlaceholderText="?sv=…&amp;sig=…  or  https://…?sv=…"/>
    </StackPanel>

    <StackPanel IsVisible="{Binding AzureContainerVisible}" Spacing="4" Margin="0,0,0,14">
      <TextBlock Text="CONTAINER (blank = list all containers)" FontSize="10" FontWeight="SemiBold" LetterSpacing="1"
                 Foreground="{StaticResource HeaderText}"/>
      <TextBox Text="{Binding AzureContainer}" PlaceholderText="my-container"/>
    </StackPanel>

    <CheckBox IsVisible="{Binding SmbFieldsVisible}" IsChecked="{Binding Guest}"
              Content="Connect as guest (no credentials)"
              Foreground="{StaticResource TextBody}" Margin="0,0,0,10"/>

    <StackPanel IsVisible="{Binding UsernameVisible}" Spacing="4" Margin="0,0,0,14">
      <TextBlock Text="USERNAME" FontSize="10" FontWeight="SemiBold" LetterSpacing="1"
                 Foreground="{StaticResource HeaderText}"/>
      <TextBox Text="{Binding Username}" PlaceholderText="user"/>
    </StackPanel>

    <StackPanel IsVisible="{Binding SftpAuthVisible}" Spacing="0">
      <TextBlock Text="AUTHENTICATION" FontSize="10" FontWeight="SemiBold" LetterSpacing="1"
                 Foreground="{StaticResource HeaderText}" Margin="0,0,0,6"/>
      <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,10">
        <RadioButton Content="Password" IsChecked="{Binding IsPasswordMode, Mode=OneWay}"
                     GroupName="AuthMode" Click="OnPasswordModeClicked"/>
        <RadioButton Content="Key file" IsChecked="{Binding IsKeyMode, Mode=OneWay}"
                     GroupName="AuthMode" Click="OnKeyModeClicked"/>
      </StackPanel>
    </StackPanel>

    <StackPanel IsVisible="{Binding PasswordVisible}" Spacing="4" Margin="0,0,0,14">
      <TextBlock Text="PASSWORD" FontSize="10" FontWeight="SemiBold" LetterSpacing="1"
                 Foreground="{StaticResource HeaderText}"/>
      <TextBox Text="{Binding Password}" PasswordChar="•" PlaceholderText="(not stored unless checked below)"/>
    </StackPanel>

    <StackPanel IsVisible="{Binding SmbFieldsVisible}" Spacing="4" Margin="0,0,0,14">
      <TextBlock Text="DOMAIN / WORKGROUP (optional)" FontSize="10" FontWeight="SemiBold" LetterSpacing="1"
                 Foreground="{StaticResource HeaderText}"/>
      <TextBox Text="{Binding Domain}" PlaceholderText="WORKGROUP"/>
    </StackPanel>

    <StackPanel IsVisible="{Binding KeySectionVisible}" Spacing="4" Margin="0,0,0,14">
      <TextBlock Text="PRIVATE KEY FILE" FontSize="10" FontWeight="SemiBold" LetterSpacing="1"
                 Foreground="{StaticResource HeaderText}"/>
      <Grid ColumnDefinitions="*,6,Auto">
        <TextBox Grid.Column="0" Text="{Binding KeyPath}" PlaceholderText="~/.ssh/id_ed25519"/>
        <Button Grid.Column="2" Content="Browse…" Click="OnBrowseKeyFile"
                Padding="10,5" CornerRadius="6"/>
      </Grid>
      <TextBlock Text="PASSPHRASE (if key is encrypted)" FontSize="10" FontWeight="SemiBold" LetterSpacing="1"
                 Foreground="{StaticResource HeaderText}" Margin="0,8,0,0"/>
      <TextBox Text="{Binding KeyPassphrase}" PasswordChar="•" PlaceholderText="(leave blank for unencrypted key)"/>
    </StackPanel>

    <TextBlock Text="INITIAL PATH" FontSize="10" FontWeight="SemiBold" LetterSpacing="1"
               Foreground="{StaticResource HeaderText}" Margin="0,0,0,4"/>
    <TextBox Text="{Binding InitialRemotePath}" PlaceholderText="/" Margin="0,0,0,14"/>

    <CheckBox IsVisible="{Binding SaveSecretVisible}" IsChecked="{Binding SavePassword}"
              Content="Save password / secret"
              Foreground="{StaticResource TextBody}" Margin="0,0,0,14"/>

    <Border IsVisible="{Binding HostKeyWarningVisible}"
            Background="{StaticResource DangerBg}"
            BorderBrush="{StaticResource DangerRed}"
            BorderThickness="1" CornerRadius="6"
            Padding="12,10" Margin="0,0,0,10">
      <StackPanel Spacing="6">
        <TextBlock Text="Host key has changed!" FontSize="12" FontWeight="SemiBold"
                   Foreground="{StaticResource DangerText}"/>
        <TextBlock Text="{Binding OldFingerprint, StringFormat='Was:  {0}'}"
                   FontSize="11" FontFamily="{StaticResource MonoFont}"
                   Foreground="{StaticResource DangerText}" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding NewFingerprint, StringFormat='Now: {0}'}"
                   FontSize="11" FontFamily="{StaticResource MonoFont}"
                   Foreground="{StaticResource DangerText}" TextWrapping="Wrap"/>
        <TextBlock Text="Only accept if you trust the new server key (key rotation or reinstall)."
                   FontSize="11" Foreground="{StaticResource DangerText}" TextWrapping="Wrap"/>
        <Button Content="Accept new key and connect" Click="OnAcceptNewKey"
                IsEnabled="{Binding !IsConnecting}"
                Padding="10,4" CornerRadius="6" Margin="0,4,0,0"/>
      </StackPanel>
    </Border>

    <TextBlock IsVisible="{Binding HasError}" Text="{Binding ErrorText}"
               FontSize="11.5" Foreground="{StaticResource DangerRed}"
               TextWrapping="Wrap" Margin="0,0,0,10"/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel" Click="OnCancelClicked"
              Padding="18,5" CornerRadius="6"/>
      <Button Content="Connect" IsDefault="True"
              IsEnabled="{Binding !IsConnecting}"
              Click="OnConnectClicked"
              Padding="18,5" CornerRadius="6"
              Background="{StaticResource Accent}" Foreground="White"/>
    </StackPanel>

  </StackPanel>
</Window>
