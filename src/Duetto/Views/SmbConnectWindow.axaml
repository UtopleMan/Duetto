<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Duetto.ViewModels"
        x:Class="Duetto.Views.SmbConnectWindow"
        x:DataType="vm:SmbConnectDialogViewModel"
        Title="Connect to SMB Share"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBg}"
        KeyDown="OnKeyDown">

  <StackPanel Margin="24,20,24,20" Spacing="0">

    <!-- Protocol row (SMB) -->
    <TextBlock Text="PROTOCOL" FontSize="10" FontWeight="SemiBold" LetterSpacing="1"
               Foreground="{StaticResource HeaderText}" Margin="0,0,0,4"/>
    <ComboBox IsEnabled="False" SelectedIndex="0" HorizontalAlignment="Stretch" Margin="0,0,0,14">
      <ComboBoxItem Content="SMB / Samba" />
    </ComboBox>

    <!-- Name -->
    <TextBlock Text="CONNECTION NAME (optional)" FontSize="10" FontWeight="SemiBold" LetterSpacing="1"
               Foreground="{StaticResource HeaderText}" Margin="0,0,0,4"/>
    <TextBox Text="{Binding Name}" Watermark="My NAS" Margin="0,0,0,14"/>

    <!-- Host + Port -->
    <Grid ColumnDefinitions="*,8,80" Margin="0,0,0,14">
      <StackPanel Grid.Column="0" Spacing="4">
        <TextBlock Text="HOST" FontSize="10" FontWeight="SemiBold" LetterSpacing="1"
                   Foreground="{StaticResource HeaderText}"/>
        <TextBox Text="{Binding Host}" Watermark="nas.local or 192.168.1.1"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="4">
        <TextBlock Text="PORT" FontSize="10" FontWeight="SemiBold" LetterSpacing="1"
                   Foreground="{StaticResource HeaderText}"/>
        <TextBox Text="{Binding PortText}" Watermark="445"/>
      </StackPanel>
    </Grid>

    <!-- Guest toggle -->
    <CheckBox IsChecked="{Binding Guest}" Content="Connect as guest (no credentials)"
              Foreground="{StaticResource TextBody}" Margin="0,0,0,10"/>

    <!-- Credentials (hidden for guest) -->
    <StackPanel IsVisible="{Binding CredentialsVisible}" Spacing="0">
      <TextBlock Text="USERNAME" FontSize="10" FontWeight="SemiBold" LetterSpacing="1"
                 Foreground="{StaticResource HeaderText}" Margin="0,0,0,4"/>
      <TextBox Text="{Binding Username}" Watermark="user" Margin="0,0,0,14"/>

      <TextBlock Text="PASSWORD" FontSize="10" FontWeight="SemiBold" LetterSpacing="1"
                 Foreground="{StaticResource HeaderText}" Margin="0,0,0,4"/>
      <TextBox Text="{Binding Password}" PasswordChar="•"
               Watermark="(not stored unless checked below)" Margin="0,0,0,14"/>

      <TextBlock Text="DOMAIN / WORKGROUP (optional)" FontSize="10" FontWeight="SemiBold" LetterSpacing="1"
                 Foreground="{StaticResource HeaderText}" Margin="0,0,0,4"/>
      <TextBox Text="{Binding Domain}" Watermark="WORKGROUP" Margin="0,0,0,14"/>
    </StackPanel>

    <!-- Initial path -->
    <TextBlock Text="INITIAL PATH (blank = share list)" FontSize="10" FontWeight="SemiBold" LetterSpacing="1"
               Foreground="{StaticResource HeaderText}" Margin="0,0,0,4"/>
    <TextBox Text="{Binding InitialPath}" Watermark="/" Margin="0,0,0,14"/>

    <!-- Save password checkbox -->
    <CheckBox IsChecked="{Binding SavePassword}" IsVisible="{Binding CredentialsVisible}"
              Content="Save password" Foreground="{StaticResource TextBody}" Margin="0,0,0,14"/>

    <!-- Inline error text -->
    <TextBlock IsVisible="{Binding HasError}" Text="{Binding ErrorText}"
               FontSize="11.5" Foreground="{StaticResource DangerRed}"
               TextWrapping="Wrap" Margin="0,0,0,10"/>

    <!-- Buttons -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel" Click="OnCancelClicked"
              Padding="18,5" CornerRadius="6"/>
      <Button Content="Connect" IsDefault="True"
              IsEnabled="{Binding !IsConnecting}"
              Click="OnConnectClicked"
              Padding="18,5" CornerRadius="6"
              Background="{StaticResource Accent}" Foreground="White"/>
    </StackPanel>

  </StackPanel>
</Window>
